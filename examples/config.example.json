{
  "allowlist": {
    "enabled": true,
    "domains": [],
    "emails": []
  },
  "audit_log": {
    "enabled": true,
    "include_reads": true,
    "path": null,
    "max_size_bytes": 10485760,
    "max_backups": 5,
    "verify_on_startup": true
  },
  "attachments": {
    "max_total_bytes": 20971520,
    "allowed_paths": [],
    "deny_patterns": [],
    "use_default_deny_patterns": true
  },
  "rate_limit": {
    "enabled": true,
    "sends_per_hour": 30
  },
  "content_scan": {
    "enabled": true,
    "patterns": [],
    "use_default_patterns": true,
    "scan_subject": true,
    "scan_body": true,
    "scan_signature": true,
    "scan_vacation": true
  },
  "send_confirmation": {
    "required": true,
    "preview_ttl_seconds": 300
  },
  "signature": {
    "auto_append": false,
    "cache_ttl_seconds": 3600,
    "strip_html": true,
    "send_as_email": null
  }
}
